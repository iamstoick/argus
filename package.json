{
  "name": "argus",
  "version": "0.1.0",
  "description": "Codebase Dictionary & Evolution MCP Server — structural index of polyglot codebases for AI agents",
  "type": "module",
  "bin": {
    "argus": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/src/admin && cp src/admin/index.html dist/src/admin/index.html",
    "start": "node dist/src/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "chokidar": "5.0.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "0.27.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "typescript": "5.9.2"
  }
}
